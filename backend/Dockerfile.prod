# Etapa 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Instalar dependencias
COPY package.json package-lock.json ./
RUN npm install

# Copiar el resto del código y el schema de Prisma
COPY . .

# Generar cliente de Prisma y compilar NestJS
RUN npx prisma generate
RUN npm run build

# Etapa 2: Producción (Imagen súper ligera)
FROM node:20-alpine AS production

WORKDIR /app

# Copiar package.json y dependencias de producción
COPY package.json package-lock.json ./
RUN npm install --omit=dev

# Copiar el cliente de Prisma generado
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/prisma ./prisma

# Copiar el código compilado
COPY --from=builder /app/dist ./dist

# Crear carpetas necesarias y asignar permisos al usuario node
RUN mkdir -p /app/uploads /app/logs && chown -R node:node /app/uploads /app/logs

# Optimización para Node.js (Liberar memoria más rápido en VPS pequeños)
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=400"

USER node

EXPOSE 3000

CMD ["node", "dist/main"]
