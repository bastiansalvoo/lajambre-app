// Configuración básica del generador y la fuente de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  PREPARANDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum PointTransactionType {
  EARNED
  REDEEMED
  EXPIRED
}

// --- MODELOS DE DATOS ---

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String
  phone             String
  address           String?
  role              Role      @default(USER)
  orders            Order[]

  // --- SISTEMA DE PUNTOS ---
  pointsBalance     Int                @default(0)
  pointTransactions PointTransaction[]

  // --- SISTEMA DE VERIFICACIÓN ---
  isVerified        Boolean   @default(false)
  verificationToken String?   // Guardará el código secreto temporal

  // --- SESIÓN ---
  refreshToken      String?   // Token para renovar JWT sin re-login
  expoPushToken     String?   // Para notificaciones push

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Int
  image       String?
  isAvailable Boolean     @default(true)
  inStock     Boolean     @default(true)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  Int
  orderItems  OrderItem[]
}

model Extra {
  id              Int              @id @default(autoincrement())
  name            String
  price           Int
  isAvailable     Boolean          @default(true)
  orderItemExtras OrderItemExtra[]
}

// --- PREMIOS DE LAJAMBRE CLUB (canjeables con puntos) ---
model Reward {
  id              Int      @id @default(autoincrement())
  // Identificador estable referenciado por Order.rewardType (String, sin
  // relacion FK) y por la logica especial de OrdersService (ej. requiere
  // hamburguesa). No cambiar una vez creado un premio.
  code            String   @unique
  name            String
  icon            String   @default("🎁")
  pointsCost      Int
  // Descuento en CLP aplicado al total (0 si el premio es freeDelivery).
  discountAmount  Int      @default(0)
  freeDelivery    Boolean  @default(false)
  requiresBurger  Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id           Int         @id @default(autoincrement())
  user         User        @relation(fields: [userId], references: [id])
  userId       Int
  status       OrderStatus @default(PENDIENTE)
  total        Int
  deliveryFee  Int         @default(1800)

  // --- NUEVOS CAMPOS ---
  deliveryAddress String?   // Para guardar dónde se entregó físicamente
  contactPhone    String?   // Para el repartidor
  // ---------------------

  pointsEarned      Int                @default(0)
  pointsUsed        Int                @default(0)
  rewardType        String? 
  pointTransactions PointTransaction[]

  buyOrder  String? @unique
  sessionId String?

  // Oculta el pedido de "Mis Pedidos" del cliente sin borrar el registro
  // (el admin lo sigue viendo en metricas/historial completo).
  hiddenByUser Boolean @default(false)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  order           Order   @relation(fields: [orderId], references: [id])
  orderId         Int
  product         Product @relation(fields: [productId], references: [id])
  productId       Int
  quantity        Int
  priceAtPurchase Int

  extras OrderItemExtra[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemExtra {
  id              Int       @id @default(autoincrement())
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId     Int
  extra           Extra     @relation(fields: [extraId], references: [id])
  extraId         Int
  priceAtPurchase Int

  @@index([orderItemId])
  @@index([extraId])
}

// --- HISTORIAL DE PUNTOS ---
model PointTransaction {
  id        Int                  @id @default(autoincrement())
  user      User                 @relation(fields: [userId], references: [id])
  userId    Int
  order     Order?               @relation(fields: [orderId], references: [id])
  orderId   Int?
  points    Int // Positivo si gana, negativo si canjea
  type      PointTransactionType
  expiresAt DateTime? // Fecha de vencimiento (90 días)
  createdAt DateTime             @default(now())

  @@index([userId])
}

// --- CONTROL MANUAL DE APERTURA DE TIENDA ---
// Fila unica (id=1). Permite al admin cerrar el local a mano, ademas del
// horario automatico ya validado en OrdersService.isStoreOpen().
model StoreStatus {
  id        Int      @id @default(1)
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

