# Etapa 1: Construir la aplicación web (Expo)
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar archivos e instalar dependencias
COPY package.json pnpm-lock.yaml ./
RUN npm install -g pnpm && pnpm install

COPY . .

# Exportar la app de Expo como página web estática
RUN npx expo export -p web

# Etapa 2: Servir los archivos con un Nginx súper liviano
FROM nginx:alpine

# Copiar los archivos estáticos compilados desde la etapa 1
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
