# Etapa 1: Construir la aplicación web (Expo)
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar archivos e instalar dependencias
COPY package.json package-lock.json ./
RUN npm install

COPY . .

# Exportar la app de Expo como página web estática
RUN npx expo export -p web

# Etapa 2: Servir los archivos con un Nginx súper liviano
FROM nginx:alpine

# Copiar los archivos estáticos compilados desde la etapa 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Config con fallback de SPA (try_files -> index.html) para que las rutas
# de expo-router no den 404 al recargar o entrar directo por URL.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
